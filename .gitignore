# =========================================
# BB HUB Obsidian — .gitignore
# =========================================

# --- Obsidian local / volatile UI state ---
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/*/data.json
.obsidian/plugins/*/cache/
.obsidian/plugins/*/.data/
.obsidian/plugins/*/node_modules/

# Optional: ignore hotkeys/appearance if you sync settings via Sync only
# .obsidian/hotkeys.json
# .obsidian/appearance.json

# --- OS junk ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.lnk

# --- Temp & logs ---
*.tmp
*.temp
*.swp
*.swo
*~
*.log

# --- Secrets & env ---
.env
.env.*
!.env.example
98_RUNTIME/SECRETS/
98_RUNTIME/ENV/.env

# --- Backups & scratch ---
backup/
backups/
temp/
tmp/
*.bak

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Node ---
node_modules/

# --- IDE ---
.vscode/
.idea/
*.sublime-*

# --- Large / generated (add paths as needed) ---
# *.pdf
# *.zip