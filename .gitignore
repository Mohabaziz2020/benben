# =========================================
# BENBENHUB-CORE Obsidian — .gitignore
# =========================================

# --- Obsidian local / volatile UI state ---
.obsidian/workspace.json
.obsidian/workspaces.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/plugins/*/data.json
.obsidian/plugins/*/cache/
.obsidian/plugins/*/.data/
.obsidian/plugins/*/node_modules/

# --- OS junk ---
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store
*.lnk

# --- Temp & logs ---
*.tmp
*.temp
*.swp
*.swo
*~
*.log

# --- Secrets & env ---
.env
.env.*
!.env.example
**/SECRETS/
**/.env

# --- Backups & scratch ---
backup/
backups/
temp/
tmp/
*.bak
_remote_check/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- Node ---
node_modules/

# --- IDE ---
.vscode/
.idea/
*.sublime-*